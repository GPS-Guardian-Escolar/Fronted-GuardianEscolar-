EXPO_PUBLIC_API_URL=/api
EXPO_PUBLIC_WS_URL=/ws
EXPO_PUBLIC_STUDENT_LINK_BASE_URL=/
EXPO_PUBLIC_API_PORT=8080
EXPO_PUBLIC_FRONTEND_PORT=8081
# Expo/Development Build runs on a separate local port, normally 8082.
# The Docker web frontend remains on EXPO_PUBLIC_FRONTEND_PORT (8081).
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key
